# Required HashPay M-Pesa STK Push credentials. Keep these on the server.
HASHPAY_API_KEY=replace_with_private_api_key
HASHPAY_ACCOUNT_ID=replace_with_payment_channel_id
HASHPAY_WEBHOOK_SECRET=replace_with_webhook_signing_secret

# Shared MongoDB cluster URL; Task Vault always uses its own database name.
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/shared?retryWrites=true&w=majority
MONGO_DB_NAME=task_vault

# Required for member sessions and the private /admin login.
SESSION_SECRET=replace_with_a_long_random_secret
ADMIN_PASSWORD=replace_with_a_strong_admin_password

# Set the public HTTPS origin of this deployed app (no trailing slash).
PUBLIC_BASE_URL=https://your-task-vault-domain.example
# Optional exact callback override, if configured in the HashPay dashboard.
# HASHPAY_WEBHOOK_URL=https://your-task-vault-domain.example/webhooks/hashpay

PORT=4173
